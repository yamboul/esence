# Copiar como .env.local y completar (ver SUPABASE_SETUP.md).
# Sin estas variables la tienda funciona en modo demostración: sin login y sin guardar pedidos.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Pedidos: false (o vacío) = se envían por WhatsApp, aunque el login con Google esté activo.
# Ponlo en true solo cuando las Edge Functions estén desplegadas (pasos 5 a 7 de SUPABASE_SETUP.md).
VITE_ORDERS_ONLINE=false

# 'sandbox' para pruebas, 'production' para cobrar de verdad
VITE_WOMPI_ENV=sandbox

# ¡NUNCA pongas aquí la service_role key ni los secretos de Wompi/Telegram!
# Esos van como secretos de las Edge Functions (npx supabase secrets set ...).
